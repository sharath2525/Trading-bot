# =============================================================
# RULE: Only push files needed to RUN the bot after a fresh clone.
#       Everything else (reports, plans, secrets, runtime data) stays LOCAL.
# =============================================================

# ── SECRETS ──────────────────────────────────────────────────
.env
.env.*
!.env.example

# ── RUNTIME STATE (generated at runtime, not source) ─────────
state.json
state.json.tmp
active_trades.json
active_trades.json.tmp
risk_state.json
risk_state.json.tmp
daily_count.json
diary_index.json
bot_started.json
*.jsonl
*.log

# ── REPORTS & ANALYSIS (local research, never push) ──────────
reports/

# ── MARKDOWN DOCS (block all, whitelist only core project docs) ──
*.md
!README.md
!CLAUDE.md
!MASTER_RULES.md

# ── PLANNING / STRATEGY / DESIGN FILES ───────────────────────
# Catch any loose planning/analysis files by name pattern
*PLAN*
*REPORT*
*NOTES*
*STRATEGY*
*REDESIGN*
*DEPLOY*
*IMPLEMENTATION*
*ANALYSIS*
*council*
*review*

# ── JUNK / ACCIDENTAL FILES ──────────────────────────────────
0.15%
MAX_TRADE_HOURS
package-lock.json
*.txt

# ── PYTHON ───────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/
*.egg

# ── VIRTUAL ENVIRONMENTS ─────────────────────────────────────
venv/
.venv/
env/

# ── IDE ───────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── OS ────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── OPERATOR CONTROL FLAGS ────────────────────────────────────
KILLSWITCH
CIRCUIT_BREAKER_HOLD
