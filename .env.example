# ══════════════════════════════════════════════════════════════════════════════
# HYPERLIQUID TRADING AGENT — .env.example
# BB + StochRSI Mean Reversion Scalper
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git. Only .env.example is committed.
# ══════════════════════════════════════════════════════════════════════════════

# ── REQUIRED — bot will not start without these ────────────────────────────
HYPERLIQUID_PRIVATE_KEY=0x...          # Agent wallet private key (signs orders)
HYPERLIQUID_VAULT_ADDRESS=0x...        # Main wallet address (holds the funds)
HYPERLIQUID_NETWORK=mainnet            # mainnet or testnet
ANTHROPIC_API_KEY=sk-ant-...           # Anthropic API key (anomaly check only)

# ── ASSETS & INTERVAL ──────────────────────────────────────────────────────
ASSETS="BTC ETH SOL"                   # Space-separated tickers
INTERVAL=5m                            # 5m = primary timeframe for BB+StochRSI
MAX_TRADE_HOURS=1                      # Force-close after 1h if still open (backstop)

# ── BB + StochRSI SIGNAL ────────────────────────────────────────────────────
BB_PERIOD=20
BB_STD=2.0
STOCHRSI_PERIOD=14
STOCHRSI_K=3
STOCHRSI_D=3
STOCHRSI_OB=80
STOCHRSI_OS=20
TIME_LIMIT_CANDLES=8                   # Close at market after 8x5m=40min if TP not hit

# ── REGIME & SESSION ────────────────────────────────────────────────────────
TREND_PAUSE_ADX=30.0                   # 1h ADX > 30 = strong trend = pause entries
SESSION_BLOCK_START_UTC=0              # Block new entries from 00:00 UTC
SESSION_BLOCK_END_UTC=6                # ... to 06:00 UTC (thin liquidity)

# ── AI (ANOMALY DETECTOR ONLY) ──────────────────────────────────────────────
ANOMALY_TRIGGER_PCT=3.0                # Call Claude only if price moves >3% in 5 candles
AI_ANOMALY_MAX_TOKENS=10               # Binary APPROVE/REJECT — one word
AI_REGIME_MAX_TOKENS=20                # Regime label — one word
REGIME_CHECK_INTERVAL_MINUTES=120      # Background regime check every 2h
NEWS_FETCH_ENABLED=true

# ── EXECUTION ───────────────────────────────────────────────────────────────
TAKER_FEE_PCT=0.00045                  # 0.045%/side; use LIMIT orders (maker=0% on HL)
COOLDOWN_MINUTES=15                    # Block asset 15min after SL hit
MAX_DAILY_TRADES=40                    # Hard cap per UTC day

# ── RISK MANAGEMENT (all required) ─────────────────────────────────────────
MAX_POSITION_PCT=15
MAX_LEVERAGE=5
MAX_CONCURRENT_POSITIONS=3
MAX_LOSS_PER_POSITION_PCT=8
DAILY_LOSS_CIRCUIT_BREAKER_PCT=12
MANDATORY_SL_PCT=3
MAX_TOTAL_EXPOSURE_PCT=50
MIN_BALANCE_RESERVE_PCT=20

# ── WEEKLY CIRCUIT BREAKER ──────────────────────────────────────────────────
WEEKLY_LOSS_CIRCUIT_BREAKER_PCT=30       # Halt if down 30% from Monday's starting value

# ── CIRCUIT BREAKER RESTART GATE ─────────────────────────────────────────────
# Set to true to require manual intervention before trading resumes after a
# daily drawdown trip. Bot stays halted at midnight until you delete CIRCUIT_BREAKER_HOLD.
OPERATOR_CONFIRM_RESTART=false

# ── PER-ASSET ADX OVERRIDES (optional) ────────────────────────────────────
# Higher ADX threshold = allow entries in stronger trends for that asset.
# Leave commented out to use TREND_PAUSE_ADX for all assets.
# ADX_OVERRIDE_BTC=38
# ADX_OVERRIDE_ETH=35
# ADX_OVERRIDE_SPX=48
# ADX_OVERRIDE_GOLD=50

# ── API SERVER ──────────────────────────────────────────────────────────────
# WARNING: 0.0.0.0 exposes the dashboard to all network interfaces.
# Use 127.0.0.1 for local access only and SSH-tunnel for remote access.
API_HOST=127.0.0.1
APP_PORT=3000

# ── TELEGRAM ALERTS (STRONGLY RECOMMENDED) ──────────────────────────────────
# Without this, circuit breaker trips, SL failures, and KILLSWITCH events are SILENT.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
