[Unit]
Description=Hyperliquid Trading Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/hyperliquid-trading-agent
ExecStart=/usr/bin/python3 src/main.py --assets BTC ETH SOL PAXG SPX XRP DOGE LINK ADA LTC --interval 5m
EnvironmentFile=/root/hyperliquid-trading-agent/.env

# Restart policy: always restart — covers clean exits (code 0), crashes, and OOM kills.
# RestartSec=30 prevents hammering the exchange and lets the instance lock port release.
Restart=always
RestartSec=30s

# Prevent runaway restart loops: max 5 restarts in 10 minutes, then give up
StartLimitIntervalSec=600
StartLimitBurst=5

# Logging: capture stdout/stderr to systemd journal
StandardOutput=journal
StandardError=journal
SyslogIdentifier=trading-agent
# Prevent journal from eating disk — rotate after 100MB
LogRateLimitIntervalSec=30
LogRateLimitBurst=1000

# Hard limits
TimeoutStartSec=60
TimeoutStopSec=30

# Memory guard: OOM killer targets this process last; restart if it exceeds 1GB
OOMScoreAdjust=-500
MemoryMax=1G
MemorySwapMax=0

[Install]
WantedBy=multi-user.target
